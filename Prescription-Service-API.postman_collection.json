              "raw": "{\n  \"referral_id\": \"ref-postman-multi\",\n  \"doctor_id\": 2,\n  \"patient_id\": 2,\n  \"lines\": [\n    {\n      \"medication_name\": \"Metformin\",\n      \"quantity\": 90,\n      \"unit\": \"tablets\",\n      \"dosage\": \"500mg\",\n      \"frequency\": \"3x daily\",\n      \"duration_days\": 30,\n      \"refill_count\": 3\n    },\n    {\n      \"medication_name\": \"Enalapril\",\n      \"quantity\": 30,\n      \"unit\": \"tablets\",\n      \"dosage\": \"5mg\",\n      \"frequency\": \"2x daily\",\n      \"duration_days\": 30,\n      \"refill_count\": 2,\n      \"notes\": \"Blood pressure medication\"\n    },\n    {\n      \"medication_name\": \"Aspirin\",\n      \"quantity\": 30,\n      \"unit\": \"tablets\",\n      \"dosage\": \"75mg\",\n      \"frequency\": \"1x daily\",\n      \"duration_days\": 30,\n      \"refill_count\": 6,\n      \"notes\": \"For cardiovascular health\"\n    }\n  ],\n  \"notes\": \"Chronic disease management - 3 medications\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/prescriptions",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "prescriptions"
              ]
            }
          },
          "response": []
        },
