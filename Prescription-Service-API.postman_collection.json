    {
      "name": "1. CREATE PRESCRIPTIONS",
      "item": [
        {
          "name": "1.1 Create Single-Line Prescription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referral_id\": \"ref-postman-001\",\n  \"doctor_id\": 1,\n  \"patient_id\": 1,\n  \"lines\": [\n    {\n      \"medication_name\": \"Paracetamol\",\n      \"quantity\": 20,\n      \"unit\": \"tablets\",\n      \"dosage\": \"500mg\",\n      \"frequency\": \"3x daily\",\n      \"duration_days\": 7,\n      \"refill_count\": 1,\n      \"notes\": \"For fever and pain\"\n    }\n  ],\n  \"notes\": \"Single medication prescription\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/prescriptions",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "prescriptions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Create Multi-Line Prescription (3 medications)",
